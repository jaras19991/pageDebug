# private signing key — never commit
*.pem

# local developer configuration for `npm run build -- --config` (E4 D5); only the example is tracked
pds.config.json

# build artifacts
*.crx
*.zip
dist/

# deps
node_modules/

# local snapshots and test output
page-debug-snapshot-*.json
page-debug-snapshot-*.zip
test-results/
playwright-report/
coverage/

.DS_Store
Thumbs.db

# Claude Code local permissions (per-user)
.claude/settings.local.json

# source logos live outside the extension dir (E0-T6); never in dist/
src/icons/logo*.png

# Firefox signed artifacts
*.xpi
web-ext-artifacts/

# QA screenshots stay local (5 MB per epic); logs/txt/json are tracked
docs/epics/*/qa-evidence/*.png
