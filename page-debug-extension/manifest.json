{
  "manifest_version": 3,
  "name": "Page Debug Snapshot",
  "version": "1.0.0",
  "description": "Debug snapshot aktualnej strony",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Page Debug Snapshot",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["page-debug-snapshot.js"],
      "matches": ["<all_urls>"]
    }
  ]
}