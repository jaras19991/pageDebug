      "outerHTML": "<html lang=\"pl\"><head>\n  <meta charset=\"utf-8\">\n  <title>PDS fixture: early error</title>\n  <script>\n    // AC-4.1: the very first script of the document throws before DOMContentLoaded.\n    throw new Error('head-boom');\n  </script>\n  <script>\n    // AC-4.1/4.2: network, console.error and an unhandled rejection, all from <head>, before\n    // DOMContentLoaded. window.__requestsDone resolves when all three requests have finished.\n    window.__requestsDone = Promise.all([\n      fetch('/api/fail').then((r) => r.status),\n      fetch('/api/ok').then((r) => r.status),\n      new Promise((resolve) => {\n        const xhr = new XMLHttpRequest();\n        xhr.open('GET', '/api/ok?via=xhr');\n        xhr.onloadend = () => resolve(xhr.status);\n        xhr.send();\n      }),\n    ]);\n    console.error('head-console', { a: 1 });\n    Promise.reject(new Error('head-rejection'));\n  </script>\n</head>\n<body>\n  <h1>Strona testowa: błąd w nagłówku</h1>\n  <p id=\"content\">Błąd, zapytania i wpis konsoli przed DOMContentLoaded.</p>\n  <script>\n    // Unique per document, so a test can tell this load from the previous one.\n    window.__marker = 'marker-' + Math.random().toString(36).slice(2);\n    console.log(window.__marker);\n  </script>\n\n\n</body></html>"
