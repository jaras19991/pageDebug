      "outerHTML": "<html lang=\"pl\"><head>\n  <meta charset=\"utf-8\">\n  <title>PDS fixture: spa</title>\n  <script>\n    // AC-4.3 / AC-4.4: SPA navigation (pushState, replaceState, popstate) keeps one document,\n    // a full reload starts a new one. Each step logs a marker the e2e test looks for.\n    window.addEventListener('popstate', () => console.log('after-popstate'));\n    document.addEventListener('DOMContentLoaded', () => {\n      const on = (id, fn) => document.getElementById(id).addEventListener('click', fn);\n      on('push', () => {\n        history.pushState({ step: 'push' }, '', '/spa.html?view=pushed');\n        console.log('after-push');\n      });\n      on('replace', () => {\n        history.replaceState({ step: 'replace' }, '', '/spa.html?view=replaced');\n        console.log('after-replace');\n      });\n      on('fetch', () => {\n        fetch('/api/fail').catch(() => {});\n      });\n      on('reload', () => location.reload());\n    });\n  </script>\n</head>\n<body>\n  <h1>Strona testowa SPA</h1>\n  <button id=\"push\" type=\"button\">Dalej (pushState)</button>\n  <button id=\"replace\" type=\"button\">Zamień (replaceState)</button>\n  <button id=\"fetch\" type=\"button\">Pobierz dane</button>\n  <button id=\"reload\" type=\"button\">Odśwież</button>\n\n\n</body></html>"
