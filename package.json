{
  "name": "page-debug-snapshot",
  "version": "0.2.0",
  "description": "Rozszerzenie MV3 (Chrome i Firefox) zapisujące dane diagnostyczne strony do jednej paczki dla developera.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "icons": "node scripts/icons.mjs",
    "gen": "node scripts/gen-content.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "npm run build && eslint . && web-ext lint --source-dir dist/firefox",
    "dev:chrome": "node scripts/dev-browser.mjs chrome",
    "dev:firefox": "node scripts/dev-browser.mjs firefox",
    "check:history": "node scripts/check-repo.mjs --history",
    "fixtures": "node tests/e2e/helpers/fixtures-server.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
